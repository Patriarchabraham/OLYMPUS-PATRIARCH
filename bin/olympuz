#!/usr/bin/env node

/**
 * Olympuz — AI coding agent powered by Patriarch
 *
 * If dist/cli.mjs exists (built), run that.
 * Otherwise fall back to tsx to run source directly.
 */

import { existsSync } from 'fs'
import { join, dirname } from 'path'
import { fileURLToPath, pathToFileURL } from 'url'
import { freemem } from 'os'

// Heap OOM prevention: respawn with dynamically-sized heap if not yet configured.
// Uses 50% of free RAM (clamped 1.5–4GB) instead of hardcoded 4GB to prevent
// OOM on memory-constrained machines (e.g., 6GB total RAM with 2GB free).
const currentMax = parseInt(
  [...(process.env.NODE_OPTIONS || '').matchAll(/--max-old-space-size=(\d+)/g)]
    .map(m => m[1])
    .pop() || '0',
  10,
)
const freeMB = Math.floor(freemem() / 1024 / 1024)
const dynamicHeap = Math.max(1536, Math.min(4096, Math.floor(freeMB * 0.5)))
if (currentMax < dynamicHeap && !process.env._OLYMPUZ_HEAP_SET) {
  process.env._OLYMPUZ_HEAP_SET = '1'
  process.env.NODE_OPTIONS = [
    ...(process.env.NODE_OPTIONS || '').split(/\s+/).filter(Boolean),
    `--max-old-space-size=${dynamicHeap}`,
  ].join(' ')
  const { spawn } = await import('child_process')
  const child = spawn(process.argv[0], process.argv.slice(1), {
    stdio: 'inherit',
    env: process.env,
  })
  child.on('exit', code => process.exit(code ?? 1))
  // Prevent rest of this process from executing
  await new Promise(() => {})
}

const __dirname = dirname(fileURLToPath(import.meta.url))
const distPath = join(__dirname, '..', 'dist', 'cli.mjs')

if (existsSync(distPath)) {
  await import(pathToFileURL(distPath).href)
} else {
  // Fallback: use tsx to run source directly
  const srcPath = join(__dirname, '..', 'src', 'entrypoints', 'cli.tsx')
  if (existsSync(srcPath)) {
    const tsxPath = join(__dirname, '..', 'node_modules', '.bin', 'tsx')
    // Check if tsx exists
    if (existsSync(tsxPath) || existsSync(tsxPath + '.cmd')) {
      const { execFile } = await import('child_process')
      const child = execFile(
        process.platform === 'win32' ? 'npx' : 'npx',
        ['tsx', srcPath, ...process.argv.slice(2)],
        { stdio: 'inherit', env: { ...process.env } },
      )
      child.on('exit', (code) => process.exit(code ?? 1))
    } else {
      console.error(`
  olympuz: Build required.

  Run:
    npm run build

  Then:
    olympuz
`)
      process.exit(1)
    }
  } else {
    console.error(`
  olympuz: Source files not found.

  Run:
    npm install && npm run build

  Then:
    olympuz
`)
    process.exit(1)
  }
}
