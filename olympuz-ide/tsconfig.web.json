{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"composite": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"noEmit": false,
		"outDir": "out/tsbuildinfo/web",
		"tsBuildInfoFile": "out/tsbuildinfo/web.tsbuildinfo"
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"]
}
