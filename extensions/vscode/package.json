{
  "name": "olympuz-coder",
  "displayName": "Olympuz Coder",
  "description": "Quantum Supreme AI Coding Agent — multi-provider reasoning with quantum-inspired intelligence",
  "version": "0.1.0",
  "publisher": "olympuz-coder",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Chat",
    "Other"
  ],
  "keywords": [
    "ai",
    "coding",
    "agent",
    "quantum",
    "multi-provider",
    "llm",
    "assistant"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "olympuz.openTerminal",
        "title": "Olympuz: Open Terminal"
      },
      {
        "command": "olympuz.sendPrompt",
        "title": "Olympuz: Quick Prompt"
      },
      {
        "command": "olympuz.status",
        "title": "Olympuz: Status"
      },
      {
        "command": "olympuz.openChat",
        "title": "Olympuz: Open Chat Panel"
      },
      {
        "command": "olympuz.switchProvider",
        "title": "Olympuz: Switch Provider"
      }
    ],
    "configuration": {
      "title": "Olympuz Coder",
      "properties": {
        "olympuz.binaryPath": {
          "type": "string",
          "default": "olympuz",
          "description": "Path to the olympuz CLI binary"
        },
        "olympuz.defaultProvider": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "anthropic",
            "openai",
            "gemini",
            "deepseek",
            "ollama"
          ],
          "description": "Default LLM provider (empty = auto-detect)"
        },
        "olympuz.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start Olympuz terminal on VS Code launch"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "olympuz-container",
          "title": "Olympuz",
          "icon": "images/icon.svg"
        }
      ]
    },
    "views": {
      "olympuz-container": [
        {
          "type": "webview",
          "id": "olympuz.chat",
          "name": "Chat"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "id": "olympuz.terminal",
          "title": "Olympuz Terminal",
          "icon": "images/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "echo 'No linter configured'"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
