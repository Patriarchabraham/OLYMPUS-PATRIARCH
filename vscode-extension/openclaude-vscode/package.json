{
  "name": "Olympuz Coder-vscode",
  "displayName": "Olympuz Coder",
  "description": "Practical VS Code companion for Olympuz Coder with project-aware launch behavior and a real Control Center.",
  "version": "0.2.0",
  "publisher": "devnull-bootloader",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:Olympuz Coder.start",
    "onCommand:Olympuz Coder.startInWorkspaceRoot",
    "onCommand:Olympuz Coder.openDocs",
    "onCommand:Olympuz Coder.openSetupDocs",
    "onCommand:Olympuz Coder.openWorkspaceProfile",
    "onCommand:Olympuz Coder.openControlCenter",
    "onCommand:Olympuz Coder.newChat",
    "onCommand:Olympuz Coder.openChat",
    "onCommand:Olympuz Coder.resumeSession",
    "onCommand:Olympuz Coder.abortChat",
    "onView:Olympuz Coder.controlCenter",
    "onView:Olympuz Coder.chat"
  ],
  "main": "./src/extension.js",
  "files": [
    "README.md",
    "media/**",
    "src/extension.js",
    "src/presentation.js",
    "src/state.js",
    "src/chat/**",
    "themes/**"
  ],
  "contributes": {
    "commands": [
      {
        "command": "Olympuz Coder.start",
        "title": "Olympuz Coder: Launch in Terminal",
        "category": "Olympuz Coder"
      },
      {
        "command": "Olympuz Coder.startInWorkspaceRoot",
        "title": "Olympuz Coder: Launch in Workspace Root",
        "category": "Olympuz Coder"
      },
      {
        "command": "Olympuz Coder.openDocs",
        "title": "Olympuz Coder: Open Repository",
        "category": "Olympuz Coder"
      },
      {
        "command": "Olympuz Coder.openSetupDocs",
        "title": "Olympuz Coder: Open Setup Guide",
        "category": "Olympuz Coder"
      },
      {
        "command": "Olympuz Coder.openWorkspaceProfile",
        "title": "Olympuz Coder: Open Workspace Profile",
        "category": "Olympuz Coder"
      },
      {
        "command": "Olympuz Coder.openControlCenter",
        "title": "Olympuz Coder: Open Control Center",
        "category": "Olympuz Coder"
      },
      {
        "command": "Olympuz Coder.newChat",
        "title": "Olympuz Coder: New Chat",
        "category": "Olympuz Coder"
      },
      {
        "command": "Olympuz Coder.openChat",
        "title": "Olympuz Coder: Open Chat Panel",
        "category": "Olympuz Coder"
      },
      {
        "command": "Olympuz Coder.resumeSession",
        "title": "Olympuz Coder: Resume Session",
        "category": "Olympuz Coder"
      },
      {
        "command": "Olympuz Coder.abortChat",
        "title": "Olympuz Coder: Abort Generation",
        "category": "Olympuz Coder"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "Olympuz Coder",
          "title": "Olympuz Coder",
          "icon": "media/Olympuz Coder.svg"
        }
      ]
    },
    "views": {
      "Olympuz Coder": [
        {
          "id": "Olympuz Coder.chat",
          "name": "Chat",
          "type": "webview"
        },
        {
          "id": "Olympuz Coder.controlCenter",
          "name": "Control Center",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "Olympuz Coder.openChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      }
    ],
    "configuration": {
      "title": "Olympuz Coder",
      "properties": {
        "Olympuz Coder.launchCommand": {
          "type": "string",
          "default": "Olympuz Coder",
          "description": "Command run in the integrated terminal when launching Olympuz Coder."
        },
        "Olympuz Coder.terminalName": {
          "type": "string",
          "default": "Olympuz Coder",
          "description": "Integrated terminal tab name for Olympuz Coder sessions."
        },
        "Olympuz Coder.useOpenAIShim": {
          "type": "boolean",
          "default": false,
          "description": "Optionally set CLAUDE_CODE_USE_OPENAI=1 in launched Olympuz Coder terminals."
        },
        "Olympuz Coder.permissionMode": {
          "type": "string",
          "default": "acceptEdits",
          "enum": ["default", "acceptEdits", "bypassPermissions", "plan"],
          "enumDescriptions": [
            "Prompt for permission on each tool use (requires manual approval)",
            "Auto-approve file edits, prompt for other operations (recommended)",
            "Auto-approve all operations without prompting",
            "Read-only mode — no file modifications allowed"
          ],
          "description": "Permission mode for chat sessions. Controls which tool operations are auto-approved."
        }
      }
    },
    "themes": [
      {
        "label": "Olympuz Coder Terminal Black",
        "uiTheme": "vs-dark",
        "path": "./themes/Olympuz Coder-Terminal-Black.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test ./src/*.test.js",
    "lint": "node scripts/lint.js",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "keywords": [
    "Olympuz Coder",
    "terminal",
    "theme",
    "cli",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Gitlawb/Olympuz Coder"
  },
  "license": "MIT"
}
